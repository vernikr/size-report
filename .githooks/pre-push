#!/bin/sh
# Перед отправкой: тот же быстрый профиль (уже пройденный на коммиты, но коммитов в
# отправке бывает несколько) плюс то, что CI проверит по диапазону — трейлер
# `Gate-Change:` у каждого коммита, тронувшего гейт-файл. Полный набор здесь не
# гоняется: он дорогой, а его место — `pnpm run verify` и CI.
# Ставится один раз: `pnpm run hooks:install` (core.hooksPath = .githooks).
set -e
if ! command -v pnpm >/dev/null 2>&1; then
  echo "pre-push: pnpm не найден в PATH — быстрый профиль не выполнен" >&2
  exit 1
fi
pnpm run verify:fast
if git rev-parse --verify --quiet origin/main^{commit} >/dev/null; then
  exec node tools/gates/gatefiles.js --range origin/main
fi
echo "  — pre-push: origin/main нет, проверка трейлеров по диапазону не выполнена"

#!/bin/sh
# The fast profile on every edit: formatting, the bloat sensors and the fast set of checks — the same
# commands as CI, taken from one list (`tools/gates/run.js`). The full profile is heavier and belongs to
# CI and to a person before a push, not to a hook: a hook is seconds.
# Installed once: `pnpm run hooks:install` (core.hooksPath = .githooks).
set -e
if ! command -v pnpm >/dev/null 2>&1; then
  echo "pre-commit: pnpm is not in PATH — the fast profile did not run" >&2
  echo "  install the hooks again: pnpm run hooks:install" >&2
  exit 1
fi

# The commit's environment is dropped before the set runs: git hands a hook variables about **its own**
# index and prefix (measured on 2.50.1: `GIT_INDEX_FILE` is `.git/index`, or a temporary `next-index-*.lock`
# when the commit is named by paths — that one disappears with the commit; `GIT_PREFIX` is the
# subdirectory when committing from one). The checks call git themselves and inside clones, so an
# inherited index sends their writes into that same file: the run reddens with causes the tree does not
# have («invalid object … for 'data/table.toml'», «ENOENT: … src/code.js»), and — the real loss — the
# repository's own index stays empty. Settings the commit itself owns (name, date, editor) are left
# alone: they have nothing to do with the checks' git reads.
# A linked worktree adds one more of the same kind, and a worse one: git hands the hook `GIT_DIR` (its own
# `.git/worktrees/<id>`), `GIT_COMMON_DIR` and `GIT_WORK_TREE`, and those are not about the index but about
# **which repository is meant**. Inherited, they follow the checks into their own temporary directories —
# measured: with `GIT_DIR` in the environment, `git ls-files` run inside an empty repository in `/tmp` lists
# this repository's 279 files, so a check that commits in its own directory commits *here*, with its own
# message and its own index (the report's own suite writes a commit called «заметки» and leaves the index
# holding that one file). The hook therefore drops the whole family, and what is left for the checks is the
# repository they are standing in.
unset GIT_INDEX_FILE GIT_PREFIX GIT_DIR GIT_COMMON_DIR GIT_WORK_TREE

exec pnpm run verify:fast

#!/bin/sh
# Быстрый профиль на каждую правку: оформление, датчики раздувания и быстрый набор
# проверок — те же команды, что в CI (список один, `tools/gates/run.js`).
# Полный профиль (`pnpm run verify`) тяжелее и живёт в CI и перед отправкой правки,
# а не в хуке: хук — это секунды.
# Ставится один раз: `pnpm run hooks:install` (core.hooksPath = .githooks).
set -e
if ! command -v pnpm >/dev/null 2>&1; then
  echo "pre-commit: pnpm не найден в PATH — быстрый профиль не выполнен" >&2
  echo "  поставить хуки заново: pnpm run hooks:install" >&2
  exit 1
fi

# Окружение коммита снимается перед прогоном набора: git отдаёт хуку переменные
# про **свой** индекс и префикс (измерено: `GIT_INDEX_FILE` и `GIT_PREFIX`), а при
# коммите, названном путями (`git commit -- файл`), индекс подменяется временным и
# исчезает вместе с коммитом. Набор проверок зовёт git сам и в подкаталогах-клонах,
# поэтому унаследованный чужой индекс уводит его записи в этот же файл: прогон
# краснеет причинами, которых у дерева нет («invalid object … for 'data/table.toml'»,
# «ENOENT: … src/code.js»), а настоящий индекс репозитория остаётся пустым — и это
# уже потеря, а не шум. Настройки, за которые отвечает сам коммит (имя, дата,
# редактор), не трогаются: они к git-чтению проверок отношения не имеют.
unset GIT_INDEX_FILE GIT_PREFIX

exec pnpm run verify:fast

#!/bin/sh
# Отчёт об объёме обновляется после каждого коммита — без ручного шага.
#
# Живёт здесь (в `.githooks`, а не в `.git/hooks`), потому что в проекте задан
# `core.hooksPath = .githooks`: каталог хуков у него свой и версионируется. Поэтому
# строку зова инструмента вписал человек (так и советует `size install-hook`, когда
# видит чужой каталог хуков), а не сам инструмент: править версионируемый каталог
# вслепую он отказывается.
#
# Что делает зов: пересобирает `docs/size-report.html` и, если файл в git, кладёт его
# отдельным коммитом (плумбингом — индекс и незакоммиченная работа не тронуты).
# Коммит уже сделан к этому моменту, поэтому отказ инструмента ничего не роняет.
#
# Снять автоматику: убрать строку `exec` ниже. Тише сделать нельзя (`hooks.enabled`
# относится к хукам, поставленным в `.git`), поэтому выключатель тут — сам файл.
command -v node >/dev/null 2>&1 || exit 0
[ -f ./node_modules/@vernikr/size-report/bin/size.js ] || exit 0
exec node ./node_modules/@vernikr/size-report/bin/size.js hook-run

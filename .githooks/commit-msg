#!/bin/sh
# Защита гейт-файлов: правка порогов, баз, правил датчиков и самой обвязки проверок
# возможна только с трейлером `Gate-Change: <причина>` в сообщении коммита.
# Гейт не платит за себя ничем: это чтение списка файлов и строки, без прогонов.
# Ставится один раз: `pnpm run hooks:install` (core.hooksPath = .githooks).
set -e
node tools/gates/gatefiles.js --commit-msg "$1"

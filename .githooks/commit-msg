#!/bin/sh
# Gate files: a change to thresholds, baselines, sensor rules or the harness of the checks passes only
# with a `Gate-Change: <reason>` trailer in the commit message. The gate costs nothing of its own: it
# reads a list of files and one line, and runs nothing.
# Installed once: `pnpm run hooks:install` (core.hooksPath = .githooks).
set -e
node tools/gates/gatefiles.js --commit-msg "$1"

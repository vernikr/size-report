{
  "name": "size-report",
  "version": "0.0.0",
  "private": true,
  "description": "Учёт роста объёма кода и документов по истории git: raw / min / токены, интерактивный отчёт вне git",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "bin": {
    "size": "./bin/size.js"
  },
  "exports": {
    ".": "./src/size-table.js"
  },
  "files": [
    "bin",
    "src",
    "dist",
    "templates",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node --test",
    "parity": "node tools/parity-freeze.js",
    "parity:live": "node tools/parity-live.js",
    "fixture": "node tools/make-fixture.js"
  },
  "keywords": [
    "size",
    "tokens",
    "minify",
    "git-history",
    "report"
  ],
  "devDependencies": {
    "jsdom": "~26"
  }
}
